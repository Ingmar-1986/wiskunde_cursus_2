\usepackage{array}
\usepackage{tabularx}

\definecolor{fvdnavy}{HTML}{102538}

\definecolor{fvdcyan}{HTML}{16B8BE}
\definecolor{fvdcyanlight}{HTML}{F4FCFC}
\definecolor{fvdcyanicon}{HTML}{DDF6F7}

\definecolor{fvdmagenta}{HTML}{F20D68}
\definecolor{fvdmagentalight}{HTML}{FFF7FA}
\definecolor{fvdmagentaicon}{HTML}{FFE3EE}





%=================================================
% Pedagogische omgevingen
% PDF: tcolorbox
% HTML: learning-box
%=================================================

% Boekicoon voor voorkennis
\newcommand{\voorkennisicon}{%
    \begin{tikzpicture}[
        baseline=-0.6ex,
        line cap=round,
        line join=round
    ]
        \fill[fvdcyanicon] (0,0) circle (0.38cm);

        \draw[
            fvdcyan,
            line width=0.7pt
        ]
        (-0.22,0.14)
        .. controls (-0.10,0.19) and (-0.04,0.17) ..
        (0,0.10)
        --
        (0,-0.19)
        .. controls (-0.08,-0.13) and (-0.15,-0.12) ..
        (-0.22,-0.15)
        -- cycle;

        \draw[
            fvdcyan,
            line width=0.7pt
        ]
        (0.22,0.14)
        .. controls (0.10,0.19) and (0.04,0.17) ..
        (0,0.10)
        --
        (0,-0.19)
        .. controls (0.08,-0.13) and (0.15,-0.12) ..
        (0.22,-0.15)
        -- cycle;
    \end{tikzpicture}%
}

% Doelwiticoon voor leerdoelen
\newcommand{\leerdoelenicon}{%
    \begin{tikzpicture}[
        baseline=-0.6ex,
        line cap=round,
        line join=round
    ]
        \fill[fvdmagentaicon] (0,0) circle (0.38cm);

        \draw[
            fvdmagenta,
            line width=0.7pt
        ] (0,0) circle (0.20cm);

        \draw[
            fvdmagenta,
            line width=0.7pt
        ] (0,0) circle (0.10cm);

        \fill[fvdmagenta] (0,0) circle (0.025cm);

        \draw[
            fvdmagenta,
            line width=0.7pt
        ]
        (0.05,0.05) -- (0.25,0.25);

        \draw[
            fvdmagenta,
            line width=0.7pt
        ]
        (0.18,0.25) -- (0.25,0.25) -- (0.25,0.18);
    \end{tikzpicture}%
}

\newcommand{\fvdboxtitle}[3]{%
    \noindent
    \begin{tabularx}{\linewidth}{
        @{}
        >{\centering\arraybackslash}m{9mm}
        @{\hspace{2mm}}
        >{\raggedright\arraybackslash}m{34mm}
        @{\hspace{2mm}}
        X
        @{}
    }
        #1
        &
        {\large\bfseries\color{#2}#3}
        &
        {\color{#2}\rule{\linewidth}{0.45pt}}
    \end{tabularx}
    \par\vspace{2mm}
}







\newenvironment{voorkennis}
{%
    \ifdefined\HCode

        \HCode{%
            <section class="learning-box learning-box--prior">
            <div class="learning-box__header">
                <span class="learning-box__icon"></span>
                <span class="learning-box__title">Voorkennis</span>
            </div>
            <div class="learning-box__content">
        }%

        \begin{itemize}

    \else

        \begin{tcolorbox}[
            enhanced,
            breakable,
            frame hidden,
            colback=fvdcyanlight,
            coltext=fvdnavy,
            borderline west={1.8pt}{0pt}{fvdcyan},
            sharp corners,
            left=5mm,
            right=5mm,
            top=3.5mm,
            bottom=3.5mm,
            before skip=4mm,
            after skip=4mm
        ]

        \fvdboxtitle
            {\voorkennisicon}
            {fvdcyan}
            {Voorkennis}

        \begin{itemize}[
            leftmargin=6mm,
            itemsep=1.5mm,
            topsep=0mm,
            parsep=0pt
        ]

    \fi
}
{%
    \end{itemize}

    \ifdefined\HCode

        \HCode{%
            </div>
            </section>
        }%

    \else

        \end{tcolorbox}

    \fi
}

\newenvironment{leerdoelen}
{%
    \ifdefined\HCode

        \HCode{%
            <section class="learning-box learning-box--goals">
            <div class="learning-box__header">
                <span class="learning-box__icon"></span>
                <span class="learning-box__title">Leerdoelen</span>
            </div>
            <div class="learning-box__content">
        }%

        \begin{itemize}

    \else

        \begin{tcolorbox}[
            enhanced,
            breakable,
            frame hidden,
            colback=fvdmagentalight,
            coltext=fvdnavy,
            borderline west={1.8pt}{0pt}{fvdmagenta},
            sharp corners,
            left=5mm,
            right=5mm,
            top=3.5mm,
            bottom=3.5mm,
            before skip=4mm,
            after skip=4mm
        ]

        \fvdboxtitle
            {\leerdoelenicon}
            {fvdmagenta}
            {Leerdoelen}

        \begin{itemize}[
            leftmargin=6mm,
            itemsep=1.5mm,
            topsep=0mm,
            parsep=0pt
        ]

    \fi
}
{%
    \end{itemize}

    \ifdefined\HCode

        \HCode{%
            </div>
            </section>
        }%

    \else

        \end{tcolorbox}

    \fi
}
